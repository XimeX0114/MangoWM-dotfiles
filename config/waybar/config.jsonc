{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 10,

    "modules-left": [
        "ext/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "wireplumber",
        "battery",
        "network",
        "custom/power"
    ],
    
    "ext/workspaces": {
         "format": "{icon}",
         "format-icons": {
         "1": "X",
         "2": "I",
         "3": "M",
         "4": "E",
         "5": "X",
         "6": "0",
         "7": "1",
         "8": "1",
         "9": "4"
         },
         "ignore-hidden": false,
         "on-click": "activate",
         "on-click-right": "deactivate",
         "sort-by-id": true
    }, 
    
    "custom/power": {
    "format": "POWER ",
    "on-click": "wlogout -b 3 -T 750 -B 750 -L 700 -R 700",
    "tooltip": false
},
    

    "tray": {
        "icon-size": 50,
        "spacing": 10
    },

    "clock": {
        "timezone": "Local",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M  |  %a, %b %d}"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "MEMORY {}%"
    },
    "network": {
        "format": "WIFI",
        "on-click": "wifi-menu",
        "on-click-right": "kitty -e nmtui"
    },    

    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "SOUND: Muted",
        "on-click": "pavucontrol",
        "format-icons": ["SOUND", "SOUND", "SOUND"]
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon}  {capacity}%",
        "format-charging": "   {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": ["BATTERY", "BATTERY", "BATTERY", "BATTERY", "BATTERY"]
    }
}

